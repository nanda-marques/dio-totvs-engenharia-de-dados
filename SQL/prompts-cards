---

7. Criar a VIEW (só depois de tudo acima)
CREATE OR REPLACE VIEW vw_cards_detailed AS
SELECT
    c.id,
    c.name,
    c.hp,
    t.name AS type,
    s.name AS stage,
    con.name AS collection,
    c.info,
    c.attack,
    c.damage,
    c.weak,
    c.resistance,
    c.retreat,
    c.cardNumberInCollection
FROM tbl_cards c
JOIN tbl_types t ON c.type_id = t.id
JOIN tbl_stages s ON c.stage_id = s.id
JOIN tbl_connections con ON c.connection_id = con.id;

---
8. Testar a VIEW
SELECT * FROM vw_cards_detailed;